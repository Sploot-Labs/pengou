{
  "name": "@splootlabs/auth",
  "version": "0.0.0",
  "type": "module",
  "exports": { ".": { "development": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "auth:generate": "npx @better-auth/cli@latest generate --config better-auth.config.ts --output ../db/src/auth-schema.ts -y"
  },
  "dependencies": {
    "@splootlabs/db": "workspace:*",
    "@splootlabs/shared": "workspace:*",
    "better-auth": "^1.6.24"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^18.0.0 || >=20.0.0"
  }
}
