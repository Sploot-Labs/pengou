{
  "name": "@splootlabs/shared",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email-suggest": {
      "development": "./src/email-suggest.ts",
      "types": "./dist/email-suggest.d.ts",
      "default": "./dist/email-suggest.js"
    },
    "./spa-routes": {
      "development": "./src/spa-routes.ts",
      "types": "./dist/spa-routes.d.ts",
      "default": "./dist/spa-routes.js"
    },
    "./signup-source": {
      "development": "./src/signup-source.ts",
      "types": "./dist/signup-source.d.ts",
      "default": "./dist/signup-source.js"
    },
    "./i18n": {
      "development": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json --customConditions development"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0 || >=20.0.0"
  }
}
