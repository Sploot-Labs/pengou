# Copiez ce fichier en `.env` (non commité) et ajustez les valeurs pour votre environnement.
# Toutes les variables sont lues par packages/shared/src/config.ts (loadConfig / EnvSchema).

# --- Serveur ---
NODE_ENV=development
PORT=3000

# --- Multi-tenancy ---
# 'single' : un seul tenant par défaut, créé automatiquement (usage le plus courant en dev/self-host).
# 'multi'  : plusieurs tenants, résolution via appartenance (membership) de l'utilisateur.
TENANCY_MODE=single

# --- Base de données ---
DATABASE_URL=postgres://pengou:pengou@localhost:5432/pengou
# Mot de passe du rôle applicatif `app_role` (soumis au RLS), posé au démarrage. REQUIS en
# production : le serveur refuse de démarrer s'il est absent ou égal au défaut de développement
# (sauf si APP_DATABASE_URL est fourni). Générez-le avec `openssl rand -base64 24`.
# APP_DB_PASSWORD=

# --- Scaling temps réel (optionnel) ---
# Si défini, active le scaling Socket.IO via Redis (sinon : mémoire, mono-instance).
# REDIS_URL=redis://localhost:6379

# --- Sessions / Auth ---
# Secret de repli utilisé pour les sessions Fastify si BETTER_AUTH_SECRET n'est pas défini (dev/test).
SESSION_SECRET=dev-secret-change-me-please!!

# Secret Better Auth : signe les sessions/cookies d'authentification.
# REQUIS en production (NODE_ENV=production) — le serveur refuse de démarrer sans cette variable
# (voir packages/shared/src/config.ts loadConfig). En dev/test, un repli est toléré (absent,
# la variable peut rester commentée ci-dessous).
#
# Ne PAS committer de vraie valeur ici, et ne PAS copier un exemple "qui marche" tel quel dans un
# déploiement réel : un secret trouvable dans un dépôt public (ce fichier, ou docker-compose.yml)
# n'est plus un secret — n'importe qui pourrait forger des sessions signées avec. Générez une
# vraie valeur (`openssl rand -base64 32`) et placez-la dans VOTRE `.env` local (non commité,
# voir .gitignore) ou votre gestionnaire de secrets — jamais dans un fichier suivi par git.
# BETTER_AUTH_SECRET=

# URL de base publique de l'auth (utilisée pour les callbacks OAuth, les cookies, etc.).
# En PRODUCTION, mettez une URL https:// : le cookie de session n'est marqué `Secure` que si
# BETTER_AUTH_URL est en https (sinon il pourrait transiter en clair).
BETTER_AUTH_URL=http://localhost:3000

# --- Durcissement (optionnel) ---
# Plafond de requêtes HTTP par IP et par minute (anti-DoS/abus). Défaut : 1000.
# RATE_LIMIT_MAX=1000
# Proxys de confiance, séparés par des virgules : IP, CIDR ou mots-clés `loopback`, `linklocal`,
# `uniquelocal`. Seul un pair de cette liste peut annoncer l'IP du client par X-Forwarded-For
# (limites de débit, anti-brute-force de connexion). Vide par défaut : l'en-tête est ignoré, ce
# qui convient sans reverse proxy. Derrière un proxy, renseignez son adresse vue depuis le
# serveur (dans Docker, souvent la passerelle du réseau, ex. 172.16.0.0/12), sinon tous les
# clients partagent l'IP du proxy. Ne mettez jamais une plage qui inclut des clients directs.
# TRUSTED_PROXIES=127.0.0.1
# Fermer l'inscription publique une fois vos comptes créés (self-host). Les comptes existants
# continuent de se connecter. 'true' pour désactiver le sign-up e-mail/mot de passe.
# DISABLE_SIGNUP=false
# Plafond de joueurs par partie (déconnectés compris, ils peuvent revenir). Au-delà, un nouveau
# joueur reçoit « La partie est complète. ». Défaut : 640.
# MAX_PLAYERS_PER_SESSION=640
# Échecs de PIN tolérés par IP (ou par préfixe /64 en IPv6) sur 5 minutes avant de refuser les
# player:join suivants. Une classe derrière une seule IP publique partage ce budget. Défaut : 100.
# PIN_FAILURE_MAX=100

# --- Déploiement / observabilité (optionnel) ---
# Niveau de log pino (trace|debug|info|warn|error|fatal). Défaut : info.
# LOG_LEVEL=info
# Appliquer les migrations au démarrage du serveur (défaut true). Mettre 'false' en multi-instance
# et lancer `pnpm --filter @splootlabs/server migrate` dans une étape dédiée avant les répliques.
# MIGRATE_ON_BOOT=true
# Dossier de contenu supplémentaire pour la bibliothèque de questions (fichiers JSON d'instance,
# lus à chaque démarrage en plus du catalogue livré).
# LIBRARY_EXTRA_DIR=/data/library
# Endpoints : /health (liveness), /ready (readiness, ping DB), /metrics (Prometheus).

# --- Cycle de vie des parties ---
# Une partie sans activité (aucune interaction/transition moteur) depuis ce délai est
# automatiquement basculée en statut terminal `abandoned` (mono-instance).
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Période du balayage serveur qui applique la bascule ci-dessus.
SESSION_SWEEP_INTERVAL_MINUTES=5

# --- Providers OAuth sociaux (optionnels) ---
# Une paire client id/secret complète active le provider correspondant
# (voir enabledSocialProviders() dans packages/auth/src/providers.ts).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Envoi d'e-mails (optionnel) ---
# Sert à la réinitialisation du mot de passe, à la confirmation d'adresse et aux invitations par
# e-mail. Une valeur vide équivaut à une valeur absente. Trois cas, voir docs/devops.md.
#
# 1. Aucun transport (défaut) : ne rien définir. Le serveur démarre, aucun e-mail ne part, le lien
#    « Mot de passe oublié » est masqué et la limite d'un quiz ne s'applique pas.
#
# 2. SMTP générique. Avec Mailpit lancé par `docker compose up mailpit`, interface sur
#    http://localhost:8025 (utile avec `pnpm dev`) :
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Pengou <contact@pengou.fr>
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Mailpit n'offre pas STARTTLS : mettre false pour lui seul (défaut true : STARTTLS exigé hors
# port 465, ce qui convient à tout vrai serveur SMTP).
# SMTP_REQUIRE_TLS=false
# Identifiants SMTP, les deux ou aucun (Mailpit n'en demande pas). Port 465 : TLS implicite ;
# sinon STARTTLS est exigé.
# SMTP_USER=
# SMTP_PASSWORD=
#
# 3. API Brevo (transport de l'instance officielle) :
# MAIL_TRANSPORT=brevo
# MAIL_FROM=Pengou <contact@pengou.fr>
# BREVO_API_KEY=
#
# Adresse de réponse, optionnelle :
# MAIL_REPLY_TO=contact@pengou.fr
#
# Contrôle DNS du domaine des adresses saisies : auto (défaut, actif seulement si un transport
# est configuré), true ou false. À mettre à false derrière un DNS d'intranet qui ne résout pas
# l'extérieur.
# EMAIL_DOMAIN_CHECK=auto
