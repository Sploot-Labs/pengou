{
  "name": "open-source-saas",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint apps packages",
    "format": "biome format --write apps packages",
    "check": "biome check apps packages",
    "dev": "pnpm --filter @splootlabs/server dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22"
    }
  }
}
